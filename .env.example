# ABCkit frontend environment — copy to .env.local and fill in.
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# These web-config values are PUBLIC by design (Vite inlines VITE_* into the bundle);
# security comes from Firebase Auth + firestore.rules + storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region of the deployed Cloud Functions (adminUsers). Default us-central1.
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# true = talk to the local Firebase emulators started with `npm run emulators`
VITE_USE_EMULATORS=false

# NEVER put a service-account key in this file or any VITE_* variable.
