
    // ================================================================ operations (…0300_operations.sql + RLS)
    // Site reports, inventory ledger, procurement, equipment.
    // Query shapes issued by the engine (see src/backend/domains/operations.ts scopes):
    //   company-wide users: unconstrained; others: project_id == pid per project (+ project_id == null for
    //   nullable columns) and, for purchase requests/items, requested_by == uid.
    // Child tables carry a denormalised project_id (and requested_by / engineer_id) copied from the parent.
    // Trigger checks that matter for security are re-stated here; SECURITY DEFINER side effects
    // (stock balance, PO received quantities, equipment meter) are allowed only in verified shapes.

    function isInbound(t) { return t in ['receipt', 'return', 'adjustment_in', 'opening']; }
    function near(a, b) { return a - b < 0.0005 && b - a < 0.0005; }
    // a project row was deleted by a super admin: FK "on delete set null" on project_id
    function projectSetNull() {
      return isSuper() && onlyChanges(['project_id', 'updated_at']) && incoming().project_id == null;
    }

    // ---------------------------------------------------------------- site reports
    match /site_reports/{id} {
      function srDecisionOk() {
        return ((incoming().status == existing().status || !(incoming().status in ['approved', 'rejected']))
                  && keeps(['approved_by', 'approved_at']))
          || (incoming().status in ['approved', 'rejected'] && incoming().status != existing().status
                  && hasPerm('site.approve') && incoming().approved_by == uid());
      }
      allow read: if hasPerm('site.view') && canAccess(resource.data.project_id);
      allow create: if hasPerm('site.report')
        && incoming().engineer_id == uid()
        && canAccess(incoming().project_id)
        && incoming().status in ['draft', 'submitted']
        && incoming().approved_by == null
        && (incoming().client_uuid == null || incoming().client_uuid == id);
      allow update: if keeps(['number', 'client_uuid', 'created_at']) && srDecisionOk() && (
          // engineers edit their own reports until approved (site_reports_update_own)
          (existing().engineer_id == uid() && existing().status in ['draft', 'rejected', 'submitted']
             && hasPerm('site.report') && incoming().engineer_id == uid() && canAccess(incoming().project_id))
          // approvers review (site_reports_review)
          || (hasPerm('site.approve') && canAccess(existing().project_id) && canAccess(incoming().project_id))
        );
      allow delete: if (existing().engineer_id == uid() && existing().status == 'draft') || isSuper();
    }

    match /site_report_photos/{id} {
      function parentReport() { return getAfter(path('site_reports', incoming().report_id)).data; }
      allow read: if hasPerm('site.view') && canAccess(resource.data.project_id);
      allow create: if (incoming().engineer_id == uid() || hasPerm('site.approve'))
        && incoming().created_by == uid()
        && canAccess(incoming().project_id)
        && parentReport().project_id == incoming().project_id
        && parentReport().engineer_id == incoming().engineer_id;
      // only the engine's sync of the inherited fields when the report changes
      allow update: if onlyChanges(['project_id', 'engineer_id'])
        && incoming().project_id == parentReport().project_id
        && incoming().engineer_id == parentReport().engineer_id;
      allow delete: if existing().created_by == uid() || hasPerm('site.approve');
    }

    match /safety_incidents/{id} {
      allow read: if hasPerm('site.view') && canAccess(resource.data.project_id);
      allow create: if hasPerm('site.report') && canAccess(incoming().project_id);
      allow update: if hasPerm('site.report') && canAccess(existing().project_id) && canAccess(incoming().project_id);
      allow delete: if hasPerm('site.report') && canAccess(existing().project_id);
    }

    // ---------------------------------------------------------------- materials & stock ledger
    match /material_categories/{id} {
      allow read: if isActive();
      // the first user's sign-in seeds the default categories
      allow create: if hasPerm('inventory.manage') || bootstrapping();
      allow update, delete: if hasPerm('inventory.manage');
    }

    match /materials/{id} {
      // the balance moves only together with a new ledger row created in the same transaction
      function ledgerPosting() {
        let t = getAfter(path('inventory_transactions', incoming().last_txn_id)).data;
        return incoming().last_txn_id is string
          && incoming().last_txn_id != existing().get('last_txn_id', null)
          && !exists(path('inventory_transactions', incoming().last_txn_id))
          && t.material_id == id
          && t.balance_after == incoming().current_stock
          && (incoming().unit_price == existing().unit_price
              || (t.txn_type == 'receipt' && incoming().unit_price == t.unit_price))
          && onlyChanges(['current_stock', 'unit_price', 'last_txn_id', 'updated_at']);
      }
      allow read: if hasAnyPerm(['inventory.view', 'procurement.view', 'site.report']);
      allow create: if hasAnyPerm(['inventory.manage', 'procurement.manage'])
        && incoming().current_stock == 0 && incoming().get('last_txn_id', null) == null;
      allow update: if (hasAnyPerm(['inventory.manage', 'procurement.manage']) && keeps(['current_stock', 'last_txn_id']))
        || ledgerPosting();
      allow delete: if hasAnyPerm(['inventory.manage', 'procurement.manage']);
    }

    match /inventory_transactions/{id} {
      function balanceOk() {
        let t = incoming();
        let before = get(path('materials', t.material_id)).data;
        let after = getAfter(path('materials', t.material_id)).data;
        return after.get('last_txn_id', null) == id
          && after.current_stock == t.balance_after
          && near(before.current_stock + (isInbound(t.txn_type) ? t.quantity : -t.quantity), t.balance_after)
          && ((t.balance_after >= 0 && t.approved_by == null)
              || (t.balance_after < 0 && t.negative_override == true
                  && hasPerm('inventory.approve_negative') && t.approved_by == uid()));
      }
      // stock receipt posted by a goods-received line in the same transaction (id = GRN line id)
      function grnPosting() {
        let g = getAfter(path('goods_received_items', id)).data;
        return incoming().grn_item_id == id
          && !exists(path('goods_received_items', id))
          && incoming().txn_type == 'receipt'
          && g.material_id == incoming().material_id
          && g.quantity_received == incoming().quantity
          && hasAnyPerm(['procurement.manage', 'inventory.manage']);
      }
      allow read: if hasPerm('inventory.view') && canAccess(resource.data.project_id);
      allow create: if isActive()
        && incoming().created_by == uid()
        && incoming().quantity > 0
        && incoming().txn_type in ['receipt', 'issue', 'return', 'adjustment_in', 'adjustment_out', 'opening']
        && (!(incoming().txn_type in ['adjustment_in', 'adjustment_out']) || hasPerm('inventory.adjust'))
        && balanceOk()
        && ((incoming().grn_item_id == null
              && hasAnyPerm(['inventory.manage', 'inventory.approve_negative'])
              && canAccess(incoming().project_id))
            || grnPosting());
      // ledger rows are immutable: corrections are posted as adjustments
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- procurement
    match /suppliers/{id} {
      allow read: if hasAnyPerm(['procurement.view', 'finance.view']);
      allow write: if hasPerm('procurement.manage');
    }

    match /purchase_requests/{id} {
      function prDecisionOk() {
        return ((incoming().status == existing().status || !(incoming().status in ['approved', 'rejected']))
                  && keeps(['approved_by', 'approved_at']))
          || (incoming().status in ['approved', 'rejected'] && incoming().status != existing().status
                  && hasPerm('procurement.approve') && incoming().approved_by == uid());
      }
      allow read: if (hasPerm('procurement.view') && canAccess(resource.data.project_id))
        || (isActive() && resource.data.requested_by == uid());
      allow create: if hasPerm('procurement.request')
        && canAccess(incoming().project_id)
        && incoming().requested_by == uid()
        && incoming().status in ['draft', 'submitted']
        && incoming().approved_by == null;
      allow update: if keeps(['number', 'created_at']) && prDecisionOk() && (
          (isActive() && existing().requested_by == uid() && existing().status in ['draft', 'submitted', 'rejected']
             && incoming().requested_by == uid())
          || hasAnyPerm(['procurement.manage', 'procurement.approve'])
        );
      allow delete: if isActive() && existing().requested_by == uid() && existing().status == 'draft';
    }

    match /purchase_request_items/{id} {
      function editable(r) {
        return (isActive() && r.requested_by == uid() && r.status in ['draft', 'rejected']) || hasPerm('procurement.manage');
      }
      function inheritsFrom(r) { return incoming().project_id == r.project_id && incoming().requested_by == r.requested_by; }
      allow read: if (hasPerm('procurement.view') && canAccess(resource.data.project_id))
        || (isActive() && resource.data.requested_by == uid());
      allow create: if editable(get(path('purchase_requests', incoming().request_id)).data)
        && inheritsFrom(get(path('purchase_requests', incoming().request_id)).data)
        && incoming().quantity > 0;
      allow update: if (editable(get(path('purchase_requests', existing().request_id)).data)
                        && editable(get(path('purchase_requests', incoming().request_id)).data)
                        && inheritsFrom(getAfter(path('purchase_requests', incoming().request_id)).data))
        // the engine's sync of inherited fields when the request changes
        || (onlyChanges(['project_id', 'requested_by'])
            && inheritsFrom(getAfter(path('purchase_requests', existing().request_id)).data));
      allow delete: if editable(get(path('purchase_requests', existing().request_id)).data);
    }

    match /purchase_orders/{id} {
      function poTransitionOk() {
        return keeps(['number', 'created_by', 'created_at'])
          && (incoming().status != 'sent' || existing().status in ['approved', 'sent'])
          && ((incoming().status == 'approved' && existing().status != 'approved'
                 && hasPerm('procurement.approve') && incoming().approved_by == uid())
              || ((incoming().status != 'approved' || existing().status == 'approved')
                  && keeps(['approved_by', 'approved_at'])));
      }
      // status maintained by goods-received postings (storekeepers lack procurement.manage)
      function grnStatus() {
        return hasAnyPerm(['procurement.manage', 'inventory.manage'])
          && onlyChanges(['status', 'updated_at'])
          && existing().status in ['approved', 'sent', 'partially_received']
          && incoming().status in ['partially_received', 'received'];
      }
      allow read: if hasAnyPerm(['procurement.view', 'finance.view', 'inventory.manage']) && canAccess(resource.data.project_id);
      allow create: if hasPerm('procurement.manage')
        && incoming().created_by == uid()
        && incoming().status in ['draft', 'pending_approval']
        && incoming().approved_by == null;
      allow update: if (hasAnyPerm(['procurement.manage', 'procurement.approve']) && poTransitionOk()) || grnStatus();
      allow delete: if hasPerm('procurement.manage') && existing().status == 'draft';
    }

    match /purchase_order_items/{id} {
      function po(poId) { return get(path('purchase_orders', poId)).data; }
      function openPo(poId) { return po(poId).status in ['draft', 'pending_approval']; }
      // received quantity raised by a goods-received line (+10% tolerance)
      function grnReceive() {
        return hasAnyPerm(['procurement.manage', 'inventory.manage'])
          && onlyChanges(['received_qty'])
          && incoming().received_qty > existing().received_qty
          && incoming().received_qty <= existing().quantity * 1.1 + 0.0005
          && po(existing().po_id).status in ['approved', 'sent', 'partially_received'];
      }
      allow read: if hasAnyPerm(['procurement.view', 'finance.view', 'inventory.manage']) && canAccess(resource.data.project_id);
      allow create: if hasPerm('procurement.manage') && openPo(incoming().po_id)
        && incoming().project_id == po(incoming().po_id).project_id
        && incoming().quantity > 0 && incoming().received_qty == 0;
      allow update: if (hasPerm('procurement.manage') && openPo(existing().po_id) && openPo(incoming().po_id)
                        && incoming().project_id == getAfter(path('purchase_orders', incoming().po_id)).data.project_id)
        || grnReceive()
        // the engine's sync of the inherited project_id
        || (onlyChanges(['project_id'])
            && incoming().project_id == getAfter(path('purchase_orders', existing().po_id)).data.project_id);
      allow delete: if hasPerm('procurement.manage') && openPo(existing().po_id);
    }

    match /goods_received/{id} {
      allow read: if hasAnyPerm(['procurement.view', 'inventory.view']) && canAccess(resource.data.project_id);
      allow create: if hasAnyPerm(['procurement.manage', 'inventory.manage'])
        && incoming().received_by == uid()
        && (incoming().po_id == null
            || get(path('purchase_orders', incoming().po_id)).data.status in ['approved', 'sent', 'partially_received']);
      allow update: if projectSetNull();
    }

    match /goods_received_items/{id} {
      function grn() { return getAfter(path('goods_received', incoming().grn_id)).data; }
      // the PO line's received_qty rises by exactly this quantity in the same transaction
      function poLineReceived() {
        let before = get(path('purchase_order_items', incoming().po_item_id)).data;
        let after = getAfter(path('purchase_order_items', incoming().po_item_id)).data;
        return before.po_id == grn().po_id
          && near(after.received_qty - before.received_qty, incoming().quantity_received);
      }
      allow read: if hasAnyPerm(['procurement.view', 'inventory.view']) && canAccess(resource.data.project_id);
      allow create: if hasAnyPerm(['procurement.manage', 'inventory.manage'])
        && incoming().quantity_received > 0
        && incoming().project_id == grn().project_id
        && existsAfter(path('inventory_transactions', id))
        && (incoming().po_item_id == null || poLineReceived());
      // immutable; only the engine's sync of the inherited project_id
      allow update: if onlyChanges(['project_id'])
        && incoming().project_id == getAfter(path('goods_received', existing().grn_id)).data.project_id;
    }

    match /supplier_invoices/{id} {
      allow read: if hasAnyPerm(['procurement.view', 'finance.view']);
      allow create, delete: if hasAnyPerm(['procurement.manage', 'finance.manage']);
      // finance.approve holders: payment approval/void recomputes the invoice status (finance domain hook)
      allow update: if hasAnyPerm(['procurement.manage', 'finance.manage'])
        || (hasPerm('finance.approve') && onlyChanges(['status', 'updated_at'])
            && incoming().status in ['unpaid', 'partially_paid', 'paid']);
    }

    // ---------------------------------------------------------------- equipment
    match /equipment/{id} {
      allow read: if hasPerm('equipment.view');
      allow create, delete: if hasPerm('equipment.manage');
      // usage logs by site staff raise the meter reading (was a SECURITY DEFINER trigger)
      allow update: if hasPerm('equipment.manage')
        || (hasPerm('site.report') && onlyChanges(['meter_reading', 'updated_at'])
            && incoming().meter_reading > existing().meter_reading);
    }

    match /equipment_assignments/{id} {
      allow read: if hasPerm('equipment.view') && canAccess(resource.data.project_id);
      allow create: if hasPerm('equipment.manage') && canAccess(incoming().project_id);
      allow update: if hasPerm('equipment.manage') && canAccess(existing().project_id) && canAccess(incoming().project_id);
      allow delete: if hasPerm('equipment.manage') && canAccess(existing().project_id);
    }

    match /equipment_usage_logs/{id} {
      allow read: if hasPerm('equipment.view') && canAccess(resource.data.project_id);
      allow create: if hasAnyPerm(['equipment.manage', 'site.report']) && canAccess(incoming().project_id)
        && incoming().created_by == uid();
      allow update, delete: if hasPerm('equipment.manage');
    }

    match /maintenance_records/{id} {
      allow read: if hasPerm('equipment.view');
      allow write: if hasPerm('equipment.manage');
    }
