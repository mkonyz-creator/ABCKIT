{
  "name": "abckit-functions",
  "private": true,
  "description": "ABCkit Cloud Functions (user administration, AI Intelligence: chat proxy, email sync/analysis/replies, monitoring)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prebuild": "node scripts/copy-shared.mjs",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node scripts/copy-shared.mjs && node ../node_modules/vitest/vitest.mjs run --config vitest.config.ts --root .."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "openai": "^7.57.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "~5.9.3"
  }
}
